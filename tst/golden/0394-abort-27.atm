        spawn (task () {
            spawn (task () {
                await(true)
                do {
                    defer {
                        print(:3)
                    }
                    print(:1)
                    spawn (task () {
                        emit @(:global)(:)
                    }) ()
                    print(:999)
                }
            }) ()
            await(true)
            print(:2)
        }) ()
        emit @(:global)(:)
    