        spawn {
            pin ts = tasks()
            task T (v) {
                await(true)
                print(v)
                return(v)
            }
            spawn @ts T(:a)
            val b = spawn @ts T(:b)
            val v,t,ts_ = await :all ts
            print(:all, (v==:b) && (t==b) && (ts==ts_))
        }
        emit(true)
    