        val T = task () {
            spawn (task () { loop on :Draw  { print(:draw)  } }) ()
            spawn (task () { loop on :Click { print(:click) } }) ()
            loop on :Tick { print(:tick) }
        }
        pin t = spawn T()
        emit(:Tick)                            ;; on  -> tick
        toggle t (false) with <:Draw || :Click>  ;; off, both pass
        emit(:Draw)                            ;; passes -> draw
        emit(:Click)                           ;; passes -> click
        emit(:Tick)                            ;; gated
        toggle t (true)
        emit(:Tick)                            ;; on  -> tick
    