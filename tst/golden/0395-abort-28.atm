        val f = func () {
            do {
                defer {
                    print(:4)    ;; TODO: aborted func should execute defer
                }
                print(:1)
                ;;resume (coro(func () {
                    emit @(:global)(:)
                ;;})) ()
                print(:y999)
            }
        }
        spawn (task () {
            spawn (task () {
                await(true)
                do {
                    defer {
                        print(:3)
                    }
                    f()
                    print(:x999)
                }
            }) ()
            await(true)
            print(:2)
        }) ()
        emit @(:global)(:)
    