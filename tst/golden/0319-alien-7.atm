        var f = func (v) {
            val x = v@0    ;; v also holds x, both are fleeting -> unsafe
            X.print(x)      ;; x will be freed and v would contain dangling pointer
        }
        var T = task () {
            val xevt = await(true) ;;thus { it => it}   ;; NOT FLEETING (vs prv test)
            f(xevt)
        }
        spawn T()
        emit (:t [[1]])
    