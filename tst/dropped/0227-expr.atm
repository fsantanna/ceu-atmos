        print([ ] =!= [ ])
        print([1] === [1])
        print([ ] === [1])
        print([1] =!= [1])
        print([1,[],[1,2,3]] === [1,[],[1,2,3]])
        print([nil,[[1,1],1]] === [nil,[[1,1],1]])
        print([1,[1],1] =!= [1,[1],1])
        print([@(:y)=false] === [@(:x)=true])
        print([[]] === [[]])
        print([@([])=true] === [@([])=true])  ;; table keys (=== false)
    