        var tk
        set tk = task (v) {
            print(v)
            val e1 = await until (func (e) { (e && (type(e)!='table'), e) })
            print(:e1,e1)
            val e2 = await until (func (e) { (e && (type(e)!='table'), e) })
            print(:e2,e2)
        }
        print(:1)
        spawn (tk) (10)
        spawn (tk) (10)
        catch true {
            (func () {
                print(:2)
                emit(:20)
                print(:3)
                emit(:30)
            })()
        }
    