        spawn {
            pin t = spawn (task () {
                val e = await(true)
                print(:1, e)
            }) ()
            print(:0)
            (func (x) {
                if (type(x) == 'table') {
                    print(:2, x == t)
                }
            }) (await(true))
        }
        emit(:a)
        emit(:b)
    