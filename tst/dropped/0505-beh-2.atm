        val S = require "atmos.streams"
        pin x* = S.zip (S.on(1s), S.from(1))
            ::map \{it@2}
            ;;::to()      ;; 1 / 2 / 3
        spawn {
            loop on :x {
                print(x)
            }
        }
        emit @:global 1s
        emit @:global 1s
        emit @:global 1s
    