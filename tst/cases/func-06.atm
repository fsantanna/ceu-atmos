val func loc (v) {
    v + 1
}
print(loc(1))
do {
    val func x (v) {
        print(v)
    }
    x(:ok)
}
func outer () {
    func inner () { :inner }
    inner()
}
print(outer(), inner())
loop v in (func () { nil }) { print(:no) }
var n = 0
val it = func () {
    set n = n + 1
    if n > 3 => nil => (n, n * n)
}
loop a, b in it { print(a, b) }
val gen = func (s, e) {
    var nxt = s
    \{
        val cur = nxt
        set nxt = nxt + 1
        if cur >= e => nil => cur
    }
}
loop v in gen(5, 8) { print(v) }
