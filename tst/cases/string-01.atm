val s = "hello world"
print(string.len(s), string.len(""))
print(string.sub(s, 0, 4), string.sub(s, 6), string.sub(s, -5, -1))
print(string.sub(s, 3, 3), "[" ++ string.sub(s, 5, 2) ++ "]", string.sub(s, -100, 100))
print(string.find(s, "o"))
print(string.find(s, "o", 5))
print(string.find(s, "world"), string.find(s, "xyz"))
print(string.find(s, "l", -3))
print(string.find(s, ""), string.find(s, "a.c"))
X.print(string.split("a,b,,c", ","))
X.print(string.split("  one two\tthree \n"))
X.print(string.split("a--b--", "--"))
X.print(string.split("", ","))
print(string.byte("ABC"), string.byte("ABC", 1), string.byte("ABC", 9))
print(string.byte("ABC", 0, -1))
print(string.char(72, 105), string.char() == "")
print(string.upper("MiXed 1"), string.lower("MiXed 1"))
print(string.rep("ab", 3), string.rep("ab", 3, "-"), string.rep("x", 0) == "")
print(string.format("%d %5d|%-5d|%05d", 42, 42, 42, 42))
print(string.format("%x %X %o %c", 255, 255, 8, 65))
print(string.format("%.2f %g %e", 3.14159, 0.5, 1500))
print(string.format("%s %s %s %10s|", "a", 10, true, :tag))
print(string.format("100%% %d", 7.0))
print(catch true { string.format("%d", 1.5) })
print(catch true { string.format("%d") })
print(catch true { string.format("%y", 1) })
print(catch true { string.sub(10) })
print(catch true { string.split("a", "") })
print(catch true { string.char(256) })
