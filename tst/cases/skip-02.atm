;; an event loop goes back to await the next event
spawn {
    loop e on :X {
        if e.v % 2 == 0 { skip }
        print(:odd, e.v)
    }
}
spawn {
    var n = 0
    loop on :Y {
        set n = n + 1
        if n < 3 { skip() }
        print(:y, n)
    }
}
emit :X [v=1]
emit :X [v=2]
emit :X [v=3]
emit :Y
emit :Y
emit :Y
emit :Y
print(:end)
