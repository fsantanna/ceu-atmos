;; locals
pin t = [1]
var x
do {
    set x = t
}
print(x@0)
print(catch true {
    pin u = [2]
    set x = u
})
print(x@0)
func f () {
    var y
    pin a = [3]
    do {
        set y = a
        pin b = [4]
        print(catch true { set y = b })
        val z = b
        print(y@0, z@0)
    }
    set x = t
    print(catch true { set x = a })
}
f()
