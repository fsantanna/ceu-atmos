spawn (task () {
    val e = await until (it && (it@0 > 10))
    X.print(e)
    val f = await <:X until (it.n == 3)>
    print(f.n)
    val g = await :Y until (\{ it.v * 2 })
    print(g)
    val h = await while (it != :stop)
    print(h)
    val i = await :Z while (it.go)
    X.print(i)
})()
emit([5])
emit([20])
emit(:X [n=1])
emit(:X [n=3])
emit(:Y [v=21])
emit(:a)
emit(:stop)
emit(:Z [go=true])
emit(:Z [go=false])
