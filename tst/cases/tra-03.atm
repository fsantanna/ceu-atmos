val T = task () {
    spawn {
        return(10)
    }
    await(:X)
    print(:alive)
}
pin t = spawn T()
emit(:X)
print((await(t)))
print(:end)
val U = task () {
    spawn {
        await(:go)
        return(20)
    }
    await(:X)
    print(:alive)
}
pin u = spawn U()
emit(:go)
emit(:X)
print((await(u)))
print(:end)
