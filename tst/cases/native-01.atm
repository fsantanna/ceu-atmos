```:prelude
#include <math.h>
#include <string.h>
static int twice (int x) {
    return 2 * x;
}
```
val x = 10
val y = `:number twice($x.u.i) + 1`
print(y, type(y))
print(`:number sqrt(a_dbl($y) + 4)`)
print(`:boolean $x.u.i > 5`, `:boolean 0`)
val s = "hello"
print(`:string A_STR_OF($s)->s + 1`, `:string NULL`)
print(`:value a_strz("owned")`)

;; statements
var n = 0
```
for (int i=1; i<=4; i++) {
    $n = a_int($n.u.i + i);
}
```
print(n)
print(`puts("stmt");`)

;; variables: locals, captures, boxes, tasks
func f (a) {
    var b = 1
    val g = func () {
        `$b = a_int($b.u.i + $a.u.i);`
        `:number $b.u.i * 100`
    }
    print(g(), g(), b)
}
f(5)
task T (v) {
    val w = `:number $v.u.i + 1`
    await(:X)
    print(`:number $v.u.i + $w.u.i`)
}
pin t = spawn T(20)
emit(:X)
val len = `:number strlen("four")` + 1
print(len)
print(`:number 7 / 2`, `:number 7 / 2.0`, `:number.float 7 / 2`, `:number.integer 7.9`)
