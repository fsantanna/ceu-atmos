print(1 == 1 || 2)
print(1 + 2 * 3, (1 + 2) * 3, 10 - 4 - 3, 2 * 3 + 4 * 5)
print(1 + 1 == 2 && 2 < 3, 1 < 2 == true, nil || 1 + 1)
print("a" ++ 1 + 2, "n=" ++ 2 * 3 ++ "!", 1 + 2 ++ "")
print(!false && true, -2 * 3, 10 % 4 + 1, 7 // 2 * 2)
val t = [1, 2, 3]
print(#t + 1, #t * 2 - 1, t@0 + t@1 * t@2)
print(false || nil && 1, true && nil || 3, 1 < 2 && 2 < 3 || false)
