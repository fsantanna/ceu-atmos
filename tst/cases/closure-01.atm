val f = func (x) {
    (func (y) {
        (x + y)
    })
}
print(f(10)(20))
var i = 10
func g () {
    var j = 20
    val func gg () {
        return(i + j)
    }
    print(gg())
}
g()
do {
    var a = 10
    func h () {
        do {
            var b = 20
            val func hh () {
                return(a + b)
            }
            return(hh)
        }
    }
    var x = h()
    print(x())
}
