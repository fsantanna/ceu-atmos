print(math.atan2(1,1)*4 == math.pi, math.atan2(-1,0)*2 == -math.pi)
print(math.exp(0), math.log(math.exp(2)), math.log(1))
print(math.tan(0), math.asin(1)*2 == math.pi, math.acos(1), math.atan(1)*4 == math.pi)
print(catch true { math.atan2(1) })
print(math.atan(1,1)*4 == math.pi, math.atan(1,2) == math.atan2(1,2), math.atan(1,2) == math.atan(1))
